# Konfigurationsdatei mit echten Zugangsdaten (WebUntis-Login, Admin-Passwort)
config.json
# Kopien davon, etwa vor einer Aenderung von Hand angelegt
config.json.*
*.bak
# Zwischendatei beim Speichern der config.json (tempfile, Name "tmp...").
# Bricht das Speichern ab, bleibt sie liegen - mit allen Passwoertern darin.
/tmp*

# Lokale Einstellungen von Claude Code. Darin landen dauerhaft erlaubte
# Befehle im Klartext - samt Passwoertern, die in einem Befehl standen.
.claude/settings.local.json
CLAUDE.local.md

# Sonstige typische Ablagen fuer Zugangsdaten
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Messdateien der Testabdeckung (coverage)
.coverage
htmlcov/

# Virtuelle Umgebung
webuntis/
venv/
.venv/

# Logs
*.log

# Merkzettel von update.sh: mit welchem Stand der Dienst zuletzt lief
.update-laufender-stand

# Bericht von stundenraster_auslesen.py (enthaelt Servername und Schulkuerzel)
stundenraster_bericht.txt

# Waveshare Hardware-Treiber (wird per git clone separat installiert)
e-Paper/

# Editor-/OS-Artefakte
.vscode/
.idea/
.DS_Store
